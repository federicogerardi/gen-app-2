{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:4173/admin",
        "http://127.0.0.1:4173/admin/users",
        "http://127.0.0.1:4173/admin/models",
        "http://127.0.0.1:4173/admin/changelog",
        "http://127.0.0.1:4173/admin/user-reports",
        "http://127.0.0.1:4173/admin/activity"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
