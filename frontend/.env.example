# frontend/.env.example
# Variabili d'ambiente del server frontend Railway (frontend/server.mjs).
# NON sono esposte nel bundle Vite — solo lette a runtime dal processo Node.
# Copiare in .env.local per sviluppo locale.

# URL interno del backend Railway.
# Locale: http://localhost:3000
# Produzione Railway: http://<backend-service-name>.railway.internal:<backend-port>
# Deploy corrente verificato: http://gen-app-2.railway.internal:8080
BACKEND_INTERNAL_URL=http://localhost:3000

# Porta del server frontend (impostata automaticamente da Railway in produzione).
# PORT=3000
