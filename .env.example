# PostgreSQL connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gen_app_2

# PostgreSQL pool max connections (default 20).
# Increase if concurrent generation streams cause connection pool contention.
PG_POOL_MAX=20

# Redis connection URL (used by runtime + smoke idempotency checks)
# Format: redis://<user>:<password>@<host>:<port> or rediss://...
REDIS_URL=

# Optional idempotency seed prefix
IDEMPOTENCY_REDIS_KEY_PREFIX=generation:idempotency

# Runtime host/port (Railway injects PORT automatically).
HOST=0.0.0.0
PORT=3000

# Frontend origin used by CORS/CSRF (set to your frontend public URL in production).
# IMPORTANT: When CSRF_ENABLED=true (the default), at least one of CSRF_TRUSTED_ORIGINS,
# CORS_ALLOWED_ORIGINS, or FRONTEND_ORIGIN must be non-empty and must not be "*".
# Leaving all three empty will cause a startup error: "Invalid CSRF configuration: trustedOrigins must be non-empty".
# Resolution priority: CSRF_TRUSTED_ORIGINS → CORS_ALLOWED_ORIGINS → FRONTEND_ORIGIN.
FRONTEND_ORIGIN=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Cookie and CSRF hardening.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_NAME=genapp_session
CSRF_ENABLED=true

# Optional auth redirect target after Google OAuth success.
GOOGLE_OAUTH_SUCCESS_REDIRECT_PATH=/

# Optional Google OAuth credentials (required only if Google login is enabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional OpenRouter credentials (required only if generation uses OpenRouter adapter).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# Optional high-volume generation debug logs ([gen][request], [gen][model-check]).
GENERATION_DEBUG_LOGS=false

# Tools orchestrate endpoint tuning.
# Timeout in ms for /api/tools/orchestrate artifact dependency resolution (default 15000).
TOOLS_ORCHESTRATE_TIMEOUT_MS=15000
# Max artifacts scanned per orchestrate call (default 1000, bounded by workflow step count).
TOOLS_ORCHESTRATE_ARTIFACT_SCAN_LIMIT=1000
# Max artifacts scanned per hydrate call (default 1000).
TOOLS_HYDRATE_ARTIFACT_SCAN_LIMIT=1000

# Optional default DOCX visual theme for backend download serializers.
# Supported values: none, classic, google-docs
DOCX_DEFAULT_THEME=none

# GitHub Issues Integration (optional — required only if admin feature for publishing user reports as GitHub issues is enabled).
# To set up: generate a Personal Access Token at https://github.com/settings/tokens/new with 'repo:write' scope.
# If GITHUB_TOKEN is set, GITHUB_ISSUES_OWNER and GITHUB_ISSUES_REPO are required.
GITHUB_TOKEN=
GITHUB_ISSUES_OWNER=
GITHUB_ISSUES_REPO=

# GitHub API tuning (optional — defaults work for most deployments).
# GITHUB_API_BASE_URL=https://api.github.com
# GITHUB_API_VERSION=2022-11-28
# GITHUB_API_TIMEOUT_MS=8000
# GITHUB_API_MAX_RETRIES=2
# GITHUB_API_RETRY_BASE_DELAY_MS=300

# Screenshot archival configuration (Geometric tool).
# Railway Persistent Disk (or equivalent) is required for persistent storage in production.
# Default paths: /data/screenshots (production with persistent disk), /tmp/screenshots (dev local).
# SCREENSHOT_STORAGE_PATH=/data/screenshots
# SCREENSHOT_RETENTION_DAYS=30
