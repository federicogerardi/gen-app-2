{
  "name": "gen-app-2",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "set -a && . ./.env.local && set +a && npm --workspace apps/backend run start:server & npm --workspace apps/frontend run dev",
    "build": "npm --workspace apps/backend run typecheck && npm --workspace apps/frontend run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate:minimal": "npm --workspace apps/backend run db:migrate:minimal",
    "db:seed:minimal": "npm --workspace apps/backend run db:seed:minimal",
    "db:seed:redis:minimal": "npm --workspace apps/backend run db:seed:redis:minimal",
    "start": "npm --workspace apps/backend run db:migrate:minimal && npm --workspace apps/backend run start:server",
    "test:smoke": "npm --workspace apps/backend run test:smoke",
    "smoke:idempotency": "npm --workspace apps/backend run smoke:idempotency",
    "smoke:conflict": "npm --workspace apps/backend run smoke:conflict",
    "smoke:queries": "npm --workspace apps/backend run smoke:queries",
    "backend:go": "npm --workspace apps/backend run go",
    "backend:go:smoke": "npm --workspace apps/backend run go:smoke",
    "start:server": "npm --workspace apps/backend run start:server",
    "frontend:sprint:gate": "npm --workspace apps/frontend run typecheck && npm --workspace apps/frontend run test && npm --workspace apps/frontend run build && npm run backend:go"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/federicogerardi/gen-app-2.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/federicogerardi/gen-app-2/issues"
  },
  "homepage": "https://github.com/federicogerardi/gen-app-2#readme",
  "dependencies": {
    "ioredis": "^5.8.2",
    "mammoth": "^1.12.0",
    "pg": "^8.16.3",
    "typescript": "^6.0.3",
    "xstate": "^5.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6"
  }
}
