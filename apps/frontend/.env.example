# frontend/.env.example
# Variabili d'ambiente del server frontend (frontend/server.mjs).
# NON sono esposte nel bundle Vite — solo lette a runtime dal processo Node.
# Copiare in .env.local per sviluppo locale.

# URL interno/privato del backend.
# Locale: http://localhost:3000
# Deploy privato: http://<backend-service>.<internal-domain>:<port>
BACKEND_INTERNAL_URL=http://localhost:3000

# Feature capabilities (Vite).
# Alcune capability hanno fallback runtime, ma qui sono esplicitate
# per avere un template locale completo e deterministico.
VITE_CAP_PROJECTS=true
VITE_CAP_MODELS=true
VITE_CAP_ARTIFACTS=true
VITE_CAP_SESSIONS_LIST=true
VITE_CAP_SESSIONS_DETAIL=true
VITE_CAP_TOOLS_UPLOAD=true
VITE_CAP_ARTIFACT_DOWNLOAD=true
VITE_CAP_SESSION_DOWNLOAD=true

# Optional monitoring transport endpoint for browser error telemetry.
# Leave empty to disable telemetry POST transport.
VITE_MONITORING_ENDPOINT=

# Porta del server frontend (impostata dalla piattaforma in produzione).
# PORT=3000
