{"nodes": [{"id": "docs_07_governance_architecture_weaknesses_code_review", "label": "Architecture Weaknesses Code Review", "file_type": "document", "source_file": "docs/07-governance/architecture-weaknesses-code-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "generationsession_fe_dependency_weakness", "label": "GenerationSession FE Liveness Dependency Weakness", "file_type": "rationale", "source_file": "docs/07-governance/architecture-weaknesses-code-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generation flow completion remains partially dependent on Frontend/UI liveness signals. If the client disconnects or the Tool Workspace is interrupted, session completion can remain tied to FE-driven progression instead of a backend-owned continuation path. Introduce a backend-owned session batch continuation job that can resume and complete eligible GenerationSession runs without requiring FE presence."}, {"id": "tool_workspace_stuck_generation_mode", "label": "Tool Workspace Stuck in Generation Mode After Interruptions", "file_type": "rationale", "source_file": "docs/07-governance/architecture-weaknesses-code-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Interruption/error scenarios can leave the page in a non-recoverable running state with insufficient unblock feedback for the user. Add a deterministic fail-close recovery policy that forces transition out of running, surfaces actionable DispatchError, and exposes explicit user recovery actions (retry/reset/reload-session)."}, {"id": "orchestrateartifactcache_redis_cache", "label": "OrchestrateArtifactCache Redis Cache Strategy", "file_type": "rationale", "source_file": "docs/07-governance/architecture-weaknesses-code-review.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redis Hash cache for /api/tools/orchestrate provides O(1) lookup with cross-instance consistency, eliminating DB queries during active sessions. Cache-first lookup with graceful fallback to DB path on cache miss or Redis failure. Fire-and-forget cache population avoids adding latency to the critical path. TTL: 14400s."}], "edges": [{"source": "docs_07_governance_architecture_weaknesses_code_review", "target": "docs_07_governance_domain_naming_decision_log", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/07-governance/architecture-weaknesses-code-review.md", "source_location": null, "weight": 1.0}, {"source": "docs_07_governance_architecture_weaknesses_code_review", "target": "generationsession_fe_dependency_weakness", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/07-governance/architecture-weaknesses-code-review.md", "source_location": null, "weight": 1.0}, {"source": "docs_07_governance_architecture_weaknesses_code_review", "target": "tool_workspace_stuck_generation_mode", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/07-governance/architecture-weaknesses-code-review.md", "source_location": null, "weight": 1.0}, {"source": "docs_07_governance_architecture_weaknesses_code_review", "target": "orchestrateartifactcache_redis_cache", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/07-governance/architecture-weaknesses-code-review.md", "source_location": null, "weight": 1.0}, {"source": "docs_07_governance_architecture_weaknesses_code_review", "target": "docs_07_governance_frontend_ux_determinism_code_review", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/07-governance/architecture-weaknesses-code-revi