{"nodes": [{"id": "_github_instructions_dominio_ddd_first_workspace_ddd_first_workspace_policy", "label": "DDD-First Workspace Operating Policy", "file_type": "rationale", "source_file": ".github/instructions/dominio-ddd-first-workspace.instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "To prevent future code drift and costly refactoring, every phase of code writing is subject to mandatory DDD-first rules \u2014 learned from 2026-05-19 enforcement experience. DDD documentation is treated as mandatory source code and the single source of truth."}, {"id": "_github_instructions_dominio_ddd_first_workspace_mandatory_pre_work_gate", "label": "Mandatory Pre-Work Gate", "file_type": "rationale", "source_file": ".github/instructions/dominio-ddd-first-workspace.instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before editing any file, agents must read canonical DDD references in fixed order to prevent drift between code and domain language. If references are missing, stop non-DDD edits and bootstrap first."}, {"id": "_github_instructions_dominio_ddd_first_workspace_dependency_lockfile_determinism_gate", "label": "Dependency Lockfile Determinism Gate", "file_type": "rationale", "source_file": ".github/instructions/dominio-ddd-first-workspace.instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never hand-edit lockfiles. Regenerate only through npm commands to keep npm ci deterministic in CI/CD. Both root and frontend lockfiles must stay in sync."}], "edges": [{"source": "_github_instructions_dominio_ddd_first_workspace_ddd_first_workspace_policy", "target": "_github_instructions_dominio_ubiquitous_language_domain_ul_glossary", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".github/in