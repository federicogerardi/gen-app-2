# PostgreSQL connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gen_app_2

# Upstash Redis TCP/TLS URL used by ioredis.
# Format: rediss://default:<password>@<host>.upstash.io:6379
UPSTASH_REDIS_URL=

# Optional Upstash REST credentials (only if using REST APIs, not used by ioredis scripts).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional idempotency seed prefix
IDEMPOTENCY_REDIS_KEY_PREFIX=generation:idempotency
