{"nodes": [{"id": "docs_07_governance_documentation_ddd_ul_governance", "label": "Documentation Governance DDD and Ubiquitous Language", "file_type": "document", "source_file": "docs/07-governance/documentation-ddd-ul-governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ddd_first_naming_gate", "label": "DDD-First Naming Gate", "file_type": "rationale", "source_file": "docs/07-governance/documentation-ddd-ul-governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use canonical terms only. Do not introduce synonyms as primary terms. Keep deprecated aliases only when explicitly documented in the decision log. Ensures naming coherence across code, contracts, and documentation."}, {"id": "ddd_active_vs_archive_gate", "label": "Active vs Archive Gate", "file_type": "rationale", "source_file": "docs/07-governance/documentation-ddd-ul-governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Active documents are only those required for current architecture, runtime, testing, and governance operation. Superseded snapshots, historical investigations, completed plans, and duplicate variants must be archived."}, {"id": "ddd_context_ownership_gate", "label": "Context Ownership Gate", "file_type": "rationale", "source_file": "docs/07-governance/documentation-ddd-ul-governance.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each document must have one primary bounded-context ownership. Cross-context concepts must reference the context map and translation boundaries. Avoid multi-context scope creep in a single document."}, {"id": "ddd_link_simplicity_gate", "label": "Link Simplicity Gate", "file_type": "rationale", "source_file": "docs/07-governance/documentation-ddd-ul-governance.md", 